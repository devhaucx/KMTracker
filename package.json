{
  "name": "strava-ranking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "npx opennextjs-cloudflare build",
    "deploy": "npm run build:worker && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx supabase db push",
    "db:status": "npx supabase db push --dry-run",
    "db:new": "npx supabase migration new",
    "db:seed": "npx supabase db execute --file supabase/seed.sql",
    "setup:secrets": "scripts/setup-cloudflare-secrets.sh"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.111.0",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
